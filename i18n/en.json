  "phraseDesk.dc4ffce8": "\n  <div id=\"phrase-desk-settings\" class=\"inline-drawer pd-settings-root\">\n    <div class=\"inline-drawer-toggle inline-drawer-header\">\n      <b class=\"inline-drawer-title\">${0}</b>\n      <div class=\"inline-drawer-icon fa-solid fa-circle-chevron-down down\"></div>\n    </div>\n    <div class=\"inline-drawer-content pd-settings-content\" style=\"display:none;\">\n      <div class=\"pd-settings-inner\">\n      <div class=\"pd-setting-row pd-two\"><div><label>Connection profile</label><select id=\"pd-profile\" class=\"text_pole\">${1}</select></div><div><label>Auto translation</label><select id=\"pd-auto-mode\" class=\"text_pole\"><option value=\"off\">Off</option><option value=\"both\">Both</option><option value=\"char\">Character only</option><option value=\"user\">User only</option></select></div></div>\n      <div class=\"pd-setting-row pd-two\"><div><label>Chat translation</label><select id=\"pd-chat-mode\" class=\"text_pole\"><option value=\"ko\">Translation only</option><option value=\"full\">Full bilingual (choose a style)</option><option value=\"dialogue\">Bilingual dialogue only</option></select></div><div><label>Bilingual translation style</label><select id=\"pd-bilingual-style\" class=\"text_pole\"><option value=\"side_sentence\">Each sentence (beside)</option><option value=\"below_sentence\">Each sentence (below)</option><option value=\"by_line\">By line (line-break boundaries)</option><option value=\"by_paragraph\">By paragraph (blank-line boundaries)</option><option value=\"separate\">Translation above, original below (separate)</option></select></div></div>\n      <div class=\"pd-setting-row pd-two\"><div><label>Translation engine</label><select id=\"pd-translation-engine\" class=\"text_pole\"><option value=\"profile\">Connection profile</option><option value=\"google\">Quick Google Translation</option></select></div><div class=\"pd-setting-help\">Quick Google Translation does not use a connection profile or model API.</div></div>\n      <div class=\"pd-setting-row pd-two\"><div><label>Study language</label><select id=\"pd-study-language\" class=\"text_pole\">${2}</select></div><div><label>Translation language</label><select id=\"pd-target-language\" class=\"text_pole\">${3}</select></div></div>\n      <div id=\"pd-study-custom\" class=\"pd-setting-row pd-two\"><div><label>Study language name</label><input id=\"pd-study-custom-name\" class=\"text_pole\" maxlength=\"80\" value=\"${4}\" placeholder=\"Example: Esperanto\"></div><div><label>Language code (for Google Translation)</label><input id=\"pd-study-custom-code\" class=\"text_pole\" maxlength=\"35\" value=\"${5}\" placeholder=\"Example: eo\"></div></div>\n      <div id=\"pd-target-custom\" class=\"pd-setting-row pd-two\"><div><label>Translation language name</label><input id=\"pd-target-custom-name\" class=\"text_pole\" maxlength=\"80\" value=\"${6}\" placeholder=\"Example: Esperanto\"></div><div><label>Language code (for Google Translation)</label><input id=\"pd-target-custom-code\" class=\"text_pole\" maxlength=\"35\" value=\"${7}\" placeholder=\"Example: eo\"></div></div>\n      <div class=\"pd-setting-help\">Translate into the selected language regardless of the source language. Study explanations use the same language.</div>\n      <div class=\"pd-setting-row pd-option-row\"><label class=\"pd-checkline\"><input id=\"pd-bilingual-blur\" type=\"checkbox\"> <span>Blur bilingual meanings</span></label><label class=\"pd-checkline\"><input id=\"pd-bilingual-notes\" type=\"checkbox\"> <span>Show bilingual translations as notes</span></label><label class=\"pd-checkline\"><input id=\"pd-input-correction\" type=\"checkbox\"> <span>Correct input before sending</span></label><label class=\"pd-checkline\"><input id=\"pd-show-input-aa\" type=\"checkbox\"> <span>Show the input-box Aa button</span></label></div>\n      <div class=\"pd-setting-row\"><div class=\"pd-prompt-heading\"><label for=\"pd-global-prompt\">Global prompt</label></div><textarea id=\"pd-global-prompt\" class=\"text_pole\" rows=\"8\" spellcheck=\"false\">${8}</textarea><div class=\"pd-prompt-actions\"><button id=\"pd-reset-prompt\" type=\"button\" class=\"menu_button\">Restore default prompt</button></div><small class=\"pd-setting-help\">Changing prompt variables or required instructions may prevent some features from working correctly.</small></div>\n      <div class=\"pd-setting-row\"><label>Current character prompt <small id=\"pd-char-name\">${9}</small></label><textarea id=\"pd-char-prompt\" class=\"text_pole\" rows=\"3\" placeholder=\"Names, spelling, gender, address forms, and voice preferences for this character only.\">${10}</textarea></div>\n      <div class=\"pd-settings-foot\"><span><b>${11}</b> expressions saved</span><button id=\"pd-clear-chat-cache\" type=\"button\" class=\"menu_button\">Clear this chat's translation cache</button>${12}</div>\n      ${13}\n      </div>\n    </div>\n  </div>",
